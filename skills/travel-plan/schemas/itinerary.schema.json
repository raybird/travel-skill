{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/raybird/travel-skill/blob/main/skills/travel-plan/schemas/itinerary.schema.json",
  "title": "Travel Plan Canonical Itinerary",
  "type": "object",
  "required": ["trip", "itinerary"],
  "$defs": {
    "source": {
      "type": "object",
      "required": ["title", "url", "checked_at"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "pattern": "^https?://" },
        "checked_at": { "type": "string", "format": "date" },
        "claim": { "type": "string" }
      },
      "additionalProperties": true
    },
    "segment": {
      "type": "object",
      "required": ["time", "type", "name"],
      "properties": {
        "time": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
        "type": { "enum": ["attraction", "break", "meal", "travel", "optional"] },
        "name": { "type": "string", "minLength": 1 },
        "address": { "type": "string" },
        "duration_minutes": { "type": "number", "minimum": 0 },
        "buffer_minutes": { "type": "number", "minimum": 0 },
        "buffer_notes": { "type": "string" },
        "notes": { "type": "string" },
        "tips": { "type": "array", "items": { "type": "string" } },
        "coordinates": {
          "type": "object",
          "properties": {
            "lat": { "type": "number", "minimum": -90, "maximum": 90 },
            "lng": { "type": "number", "minimum": -180, "maximum": 180 }
          },
          "required": ["lat", "lng"],
          "additionalProperties": false
        },
        "map_url": { "type": "string" },
        "transit": {
          "type": "object",
          "properties": {
            "mode": { "enum": ["drive", "mrt", "bus", "train", "hsr", "taxi", "rideshare", "walk"] },
            "lines": { "type": "array" },
            "duration_minutes": { "type": "number", "minimum": 0 },
            "summary": { "type": "string" },
            "call_at": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
            "origin": { "type": "string" },
            "waypoints": { "type": "array", "items": { "type": "string" } },
            "map_url": { "type": "string" }
          },
          "additionalProperties": true
        },
        "highlights": { "type": "object", "additionalProperties": { "type": "string" } },
        "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
        "to_verify": { "type": "string" },
        "rain_plan": {
          "allOf": [
            { "$ref": "#/$defs/segment" },
            {
              "type": "object",
              "properties": { "reason": { "type": "string", "minLength": 1 } }
            }
          ]
        }
      },
      "additionalProperties": true
    }
  },
  "properties": {
    "meta": {
      "type": "object",
      "properties": {
        "generator": { "type": "string" },
        "version": { "type": "string" },
        "revision": { "type": "integer", "minimum": 1 },
        "generated_at": { "type": "string" },
        "request_id": { "type": "string" },
        "reference_date": { "type": "string", "format": "date" },
        "research_policy": { "enum": ["live", "snapshot", "offline"] }
      },
      "additionalProperties": true
    },
    "trip": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "duration_days": { "type": "integer", "minimum": 1 },
        "date": { "type": "string", "format": "date" },
        "starting_point": { "type": "string" },
        "transportation": { "type": "string" }
      },
      "additionalProperties": true
    },
    "travelers": { "type": "array", "items": { "type": "object" } },
    "lodging": { "type": "array", "items": { "type": "object" } },
    "constraints": { "type": "array", "items": { "type": "object" } },
    "changes": { "type": "array", "items": { "type": "object" } },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "field", "value", "reason"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "field": { "type": "string", "minLength": 1 },
          "value": {},
          "reason": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "topic", "decision", "reason"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "topic": { "type": "string", "minLength": 1 },
          "decision": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "evidence": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "itinerary": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["day", "segments"],
        "properties": {
          "day": { "type": "integer", "minimum": 1 },
          "title": { "type": "string" },
          "date": { "type": "string", "format": "date" },
          "weather": { "type": "object" },
          "segments": { "type": "array", "items": { "$ref": "#/$defs/segment" } },
          "travel_notes": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "summary": { "type": "object" }
  },
  "additionalProperties": true
}
